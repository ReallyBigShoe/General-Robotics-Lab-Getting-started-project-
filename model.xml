<mujoco model="General Robotics Robot">

    <compiler angle="degree"
              meshdir="Assets"
              inertiafromgeom="false"/>

    <option timestep="0.001"
            gravity="0 0 -9.81"
            integrator="implicitfast"
            iterations="50"/>


    <!-- ====================================================== -->
    <!-- ASSETS                                                 -->
    <!-- ====================================================== -->

    <asset>

        <mesh name="base_mesh" file="base_link.stl"/>

        <mesh name="leg_fl_mesh" file="Leg_FL.stl"/>
        <mesh name="leg_fr_mesh" file="Leg_FR.stl"/>
        <mesh name="leg_bl_mesh" file="Leg_BL.stl"/>
        <mesh name="leg_br_mesh" file="Leg_BR.stl"/>

        <mesh name="wheel_fl_mesh" file="Wheel_FL.stl"/>
        <mesh name="wheel_fr_mesh" file="Wheel_FR.stl"/>
        <mesh name="wheel_bl_mesh" file="Wheel_BL.stl"/>
        <mesh name="wheel_br_mesh" file="Wheel_BR.stl"/>

    </asset>


    <!-- ====================================================== -->
    <!-- WORLD                                                  -->
    <!-- ====================================================== -->

    <worldbody>

        <geom name="floor"
              type="plane"
              pos="0 0 0"
              size="2 2 0.1"
              friction="1 0.05 0.01"
              contype="1"
              conaffinity="1"
              group="0"/>


        <!-- ================================================== -->
        <!-- ROBOT                                              -->
        <!-- ================================================== -->

        <body name="base_link"
              pos="0 0 0.08373">

            <freejoint name="root_freejoint"/>


            <!-- ================================================== -->
            <!-- BASE                                               -->
            <!-- ================================================== -->

            <geom name="base_visual"
                  type="mesh"
                  mesh="base_mesh"
                  contype="0"
                  conaffinity="0"
                  group="2"/>

            <inertial
                pos="-0.070214 -0.000712 0.050450"
                mass="2.188379"
                fullinertia="
                    0.076070
                    0.085530
                    0.122000
                    0.000022967131
                    -0.000009709464
                    -0.000011921456"/>

            <site name="imu_site"
                  pos="-0.070214 -0.000712 0.050450"
                  size="0.005"
                  rgba="1 0 0 1"/>

            <geom name="base_collision_lower"
                  type="box"
                  pos="-0.070 0 0.03125"
                  size="0.085 0.093 0.03125"
                  friction="1 0.05 0.01"
                  contype="1"
                  conaffinity="1"
                  group="3"/>

            <geom name="base_collision_upper"
                  type="box"
                  pos="-0.070 0 0.08200"
                  size="0.085 0.093 0.01950"
                  friction="1 0.05 0.01"
                  contype="1"
                  conaffinity="1"
                  group="3"/>


            <!-- ================================================== -->
            <!-- FRONT RIGHT                                       -->
            <!-- ================================================== -->

            <body name="Leg_FR"
                  pos="0.010 0.065 0.0225">

                <!--
                    FRONT-RIGHT RANGE
                    -75 deg -> +45 deg
                -->

                <joint name="hip_FR"
                       type="hinge"
                       axis="1 0 0"
                       damping="2"
                       limited="true"
                       range="-75 45"/>

                <geom name="leg_FR_visual"
                      type="mesh"
                      mesh="leg_fr_mesh"
                      pos="-0.010 -0.065 -0.0225"
                      contype="0"
                      conaffinity="0"
                      group="2"/>

                <geom name="leg_FR_collision"
                      type="capsule"
                      fromto="
                          -0.0006 0.0061 -0.0087
                          -0.0044 0.0450 -0.0640"
                      size="0.014"
                      friction="1 0.05 0.01"
                      contype="1"
                      conaffinity="1"
                      group="3"/>

                <inertial
                    pos="0.039288 0.029282 -0.041676"
                    mass="0.082136"
                    fullinertia="
                        0.000136800
                        0.000116800
                        0.000075936346
                        -0.000007677130
                        0.000010997569
                        0.000057220861"/>


                <body name="Wheel_FR"
                      pos="-0.005 0.051075 -0.072731">

                    <joint name="wheel_FR"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"/>

                    <geom name="wheel_FR_visual"
                          type="mesh"
                          mesh="wheel_fr_mesh"
                          pos="-0.005 -0.116075 0.050231"
                          contype="0"
                          conaffinity="0"
                          group="2"/>

                    <geom name="wheel_FR_collision"
                          type="cylinder"
                          pos="0 0 0"
                          euler="0 90 0"
                          size="0.0284985 0.010"
                          friction="1 0.05 0.01"
                          contype="1"
                          conaffinity="1"
                          group="3"/>

                    <inertial
                        pos="-0.001355 0 0"
                        mass="0.038316"
                        fullinertia="
                            0.000018581992
                            0.000011054022
                            0.000011053486
                            0
                            0
                            0.000000001523"/>

                </body>

            </body>


            <!-- ================================================== -->
            <!-- FRONT LEFT                                        -->
            <!-- ================================================== -->

            <body name="Leg_FL"
                  pos="-0.150 0.065 0.0225">

                <!--
                    FRONT-LEFT RANGE
                    -75 deg -> +45 deg
                -->

                <joint name="hip_FL"
                       type="hinge"
                       axis="1 0 0"
                       damping="2"
                       limited="true"
                       range="-75 45"/>

                <geom name="leg_FL_visual"
                      type="mesh"
                      mesh="leg_fl_mesh"
                      pos="0.150 -0.065 -0.0225"
                      contype="0"
                      conaffinity="0"
                      group="2"/>

                <geom name="leg_FL_collision"
                      type="capsule"
                      fromto="
                          0.0006 0.0061 -0.0087
                          0.0044 0.0450 -0.0640"
                      size="0.014"
                      friction="1 0.05 0.01"
                      contype="1"
                      conaffinity="1"
                      group="3"/>

                <inertial
                    pos="-0.037573 0.035469 -0.050682"
                    mass="0.141223"
                    fullinertia="
                        0.000172400
                        0.000145600
                        0.000093954807
                        0.000005261590
                        -0.000007566613
                        0.000071755082"/>


                <body name="Wheel_FL"
                      pos="0.005 0.051075 -0.072731">

                    <joint name="wheel_FL"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"/>

                    <geom name="wheel_FL_visual"
                          type="mesh"
                          mesh="wheel_fl_mesh"
                          pos="0.145 -0.116075 0.050231"
                          contype="0"
                          conaffinity="0"
                          group="2"/>

                    <geom name="wheel_FL_collision"
                          type="cylinder"
                          pos="0 0 0"
                          euler="0 90 0"
                          size="0.0284985 0.010"
                          friction="1 0.05 0.01"
                          contype="1"
                          conaffinity="1"
                          group="3"/>

                    <inertial
                        pos="0.001355 0 0"
                        mass="0.038316"
                        fullinertia="
                            0.000018581992
                            0.000011054022
                            0.000011053486
                            0
                            0
                            0.000000001523"/>

                </body>

            </body>


            <!-- ================================================== -->
            <!-- BACK RIGHT                                        -->
            <!-- ================================================== -->

            <body name="Leg_BR"
                  pos="0.010 -0.065 0.0225">

                <!--
                    BACK-RIGHT RANGE
                    -45 deg -> +75 deg
                -->

                <joint name="hip_BR"
                       type="hinge"
                       axis="1 0 0"
                       damping="2"
                       limited="true"
                       range="-45 75"/>

                <geom name="leg_BR_visual"
                      type="mesh"
                      mesh="leg_br_mesh"
                      pos="-0.010 0.065 -0.0225"
                      contype="0"
                      conaffinity="0"
                      group="2"/>

                <geom name="leg_BR_collision"
                      type="capsule"
                      fromto="
                          -0.0006 -0.0061 -0.0087
                          -0.0044 -0.0450 -0.0640"
                      size="0.014"
                      friction="1 0.05 0.01"
                      contype="1"
                      conaffinity="1"
                      group="3"/>

                <inertial
                    pos="0.039288 -0.029282 -0.041676"
                    mass="0.082135"
                    fullinertia="
                        0.000136800
                        0.000116800
                        0.000075935966
                        0.000007676943
                        0.000010997300
                        -0.000057220600"/>


                <body name="Wheel_BR"
                      pos="-0.005 -0.051075 -0.072731">

                    <joint name="wheel_BR"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"/>

                    <geom name="wheel_BR_visual"
                          type="mesh"
                          mesh="wheel_br_mesh"
                          pos="-0.005 0.116075 0.050231"
                          contype="0"
                          conaffinity="0"
                          group="2"/>

                    <geom name="wheel_BR_collision"
                          type="cylinder"
                          pos="0 0 0"
                          euler="0 90 0"
                          size="0.0284985 0.010"
                          friction="1 0.05 0.01"
                          contype="1"
                          conaffinity="1"
                          group="3"/>

                    <inertial
                        pos="-0.001355 0 0"
                        mass="0.038316"
                        fullinertia="
                            0.000018581992
                            0.000011054022
                            0.000011053486
                            0
                            0
                            -0.000000001523"/>

                </body>

            </body>


            <!-- ================================================== -->
            <!-- BACK LEFT                                         -->
            <!-- ================================================== -->

            <body name="Leg_BL"
                  pos="-0.150 -0.065 0.0225">

                <!--
                    FIXED BACK-LEFT RANGE

                    OLD:
                        -75 -> +45

                    CORRECT:
                        -45 -> +75

                    Axis remains unchanged.
                -->

                <joint name="hip_BL"
                       type="hinge"
                       axis="1 0 0"
                       damping="2"
                       limited="true"
                       range="-45 75"/>

                <geom name="leg_BL_visual"
                      type="mesh"
                      mesh="leg_bl_mesh"
                      pos="0.150 0.065 -0.0225"
                      contype="0"
                      conaffinity="0"
                      group="2"/>

                <geom name="leg_BL_collision"
                      type="capsule"
                      fromto="
                          0.0006 -0.0061 -0.0087
                          0.0044 -0.0450 -0.0640"
                      size="0.014"
                      friction="1 0.05 0.01"
                      contype="1"
                      conaffinity="1"
                      group="3"/>

                <inertial
                    pos="-0.039288 -0.029282 -0.041676"
                    mass="0.082135"
                    fullinertia="
                        0.000136800
                        0.000116800
                        0.000075935772
                        -0.000007677012
                        -0.000010997397
                        -0.000057220295"/>


                <body name="Wheel_BL"
                      pos="0.005 -0.051075 -0.072731">

                    <joint name="wheel_BL"
                           type="hinge"
                           axis="1 0 0"
                           damping="0.02"/>

                    <geom name="wheel_BL_visual"
                          type="mesh"
                          mesh="wheel_bl_mesh"
                          pos="0.145 0.116075 0.050231"
                          contype="0"
                          conaffinity="0"
                          group="2"/>

                    <geom name="wheel_BL_collision"
                          type="cylinder"
                          pos="0 0 0"
                          euler="0 90 0"
                          size="0.0284985 0.010"
                          friction="1 0.05 0.01"
                          contype="1"
                          conaffinity="1"
                          group="3"/>

                    <inertial
                        pos="0.001355 0 0"
                        mass="0.038316"
                        fullinertia="
                            0.000018581992
                            0.000011054022
                            0.000011053486
                            0
                            0
                            -0.000000001523"/>

                </body>

            </body>

        </body>

    </worldbody>


    <!-- ====================================================== -->
    <!-- CONTACT EXCLUSIONS                                     -->
    <!-- ====================================================== -->

    <contact>

        <exclude body1="base_link" body2="Leg_FR"/>
        <exclude body1="base_link" body2="Leg_FL"/>
        <exclude body1="base_link" body2="Leg_BR"/>
        <exclude body1="base_link" body2="Leg_BL"/>

        <exclude body1="Leg_FR" body2="Wheel_FR"/>
        <exclude body1="Leg_FL" body2="Wheel_FL"/>
        <exclude body1="Leg_BR" body2="Wheel_BR"/>
        <exclude body1="Leg_BL" body2="Wheel_BL"/>

    </contact>


    <!-- ====================================================== -->
    <!-- ACTUATORS                                              -->
    <!-- ====================================================== -->

    <actuator>


        <!-- ================================================== -->
        <!-- FRONT RIGHT                                       -->
        <!-- -75 deg -> +45 deg                                -->
        <!-- ================================================== -->

        <position name="hip_motor_FR"
                  joint="hip_FR"
                  kp="10"
                  ctrlrange="-1.308997 0.785398"/>


        <!-- ================================================== -->
        <!-- FRONT LEFT                                        -->
        <!-- -75 deg -> +45 deg                                -->
        <!-- ================================================== -->

        <position name="hip_motor_FL"
                  joint="hip_FL"
                  kp="10"
                  ctrlrange="-1.308997 0.785398"/>


        <!-- ================================================== -->
        <!-- BACK RIGHT                                        -->
        <!-- -45 deg -> +75 deg                                -->
        <!-- ================================================== -->

        <position name="hip_motor_BR"
                  joint="hip_BR"
                  kp="10"
                  ctrlrange="-0.785398 1.308997"/>


        <!-- ================================================== -->
        <!-- BACK LEFT                                         -->
        <!-- FIXED: -45 deg -> +75 deg                         -->
        <!-- ================================================== -->

        <position name="hip_motor_BL"
                  joint="hip_BL"
                  kp="10"
                  ctrlrange="-0.785398 1.308997"/>


        <!-- ================================================== -->
        <!-- WHEEL TORQUE ACTUATORS                             -->
        <!-- ================================================== -->

        <motor name="wheel_motor_FR"
               joint="wheel_FR"
               gear="1"
               ctrllimited="true"
               ctrlrange="-1 1"/>

        <motor name="wheel_motor_FL"
               joint="wheel_FL"
               gear="1"
               ctrllimited="true"
               ctrlrange="-1 1"/>

        <motor name="wheel_motor_BR"
               joint="wheel_BR"
               gear="1"
               ctrllimited="true"
               ctrlrange="-1 1"/>

        <motor name="wheel_motor_BL"
               joint="wheel_BL"
               gear="1"
               ctrllimited="true"
               ctrlrange="-1 1"/>

    </actuator>


    <!-- ====================================================== -->
    <!-- SENSORS                                                -->
    <!-- ====================================================== -->

    <sensor>

        <framequat name="imu_orientation"
                   objtype="site"
                   objname="imu_site"/>

        <gyro name="imu_gyro"
              site="imu_site"/>

        <accelerometer name="imu_accel"
                       site="imu_site"/>

        <framepos name="robot_position"
                  objtype="site"
                  objname="imu_site"/>

    </sensor>

</mujoco>